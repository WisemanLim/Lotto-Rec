# Lotto-Rec — local 환경 (.env.local 로 복사하여 사용; .env.local 은 git 제외)
# 변수명 규칙: 한국어 용어 직역 + LOTTO_ 접두어 (PRD §10)
ENV=local
APP_NAME=Lotto number recommender

# ── 추천 / 로또번호 추천 갯수 ─────────────────────────────
LOTTO_NUMBER_RECOMMENDATION_COUNT=10   # 1~50

# ── 게임 규칙 ─────────────────────────────────────────────
LOTTO_POOL_SIZE=45                     # N
LOTTO_MAIN_COUNT=6                     # k

# ── 데이터 / 군 분할 ─────────────────────────────────────
LOTTO_TRAIN_END_DRAW=1000              # 군 A 마지막 회차 (군 B = 이후)
LOTTO_SOURCE_FILE=".docs/lotto(~1240).xlsx"
LOTTO_DB_PATH=data/lotto.db
LOTTO_CACHE_DIR=data/cache
DATABASE_URL=sqlite:///./data/lotto.db # backend/ 기준이 아니라 프로젝트 루트 기준 (config 에서 절대경로화)

# ── 통계 ─────────────────────────────────────────────────
LOTTO_SIGNIFICANCE_LEVEL=0.05
LOTTO_DEFAULT_CORRECTION=fdr_bh        # bonferroni | holm | fdr_bh | fdr_by
LOTTO_MC_ITERATIONS=10000              # quick
LOTTO_MC_ITERATIONS_REPORT=100000      # report
LOTTO_MC_ITERATIONS_DEEP=500000        # deep (기본값 정의, 시간 목표 없음)
LOTTO_RANDOM_SEED=20260908
LOTTO_MIN_EFFECT_DELTA=0.25
LOTTO_CROSS_DRAW_LAG=5                 # 회차간 교차 공출현 전/후 간격 L (1~50, lag 1..L 개별 + 창 합산)
LOTTO_AUTO_RERUN_PRESET=quick
LOTTO_RUN_RETENTION=20                 # 분석 run 보존 개수 (0=무제한)          # quick | report | deep | off
LOTTO_LOTTERY_PICK_COUNT=5            # 내 번호 '등록된 번호로 추첨 시도' 선택(★) 개수 기본값 (1~50)
LOTTO_SEED_SEARCH_MAX_ITER=20000000   # 추천 'SEED 값 생성' 무작위 탐색 최대 시행 횟수 (안전 상한)
LOTTO_RECENT_DRAWS=5                   # 내 번호 '저장된 번호' 타이틀 우측 최근 당첨번호 회차 수 (1~20)

# 3~5등 고정 당첨금 (원, 가정값 — 회차 데이터 없음)
LOTTO_PRIZE_RANK3_DEFAULT=1500000
LOTTO_PRIZE_RANK4_DEFAULT=50000
LOTTO_PRIZE_RANK5_DEFAULT=5000          # quick | report | deep | off

# ── 서버 ─────────────────────────────────────────────────
LOTTO_TIMEZONE=Asia/Seoul                # 표시 시간대 (IANA). 저장은 UTC
VITE_TIMEZONE=Asia/Seoul                 # 프론트 기본 표시 시간대(/config 로 덮어씀)
LOTTO_BACKEND_HOST=127.0.0.1
LOTTO_BACKEND_PORT=8000
LOTTO_FRONTEND_PORT=5173
VITE_API_BASE=http://127.0.0.1:8000    # frontend (Vite envDir=루트)
